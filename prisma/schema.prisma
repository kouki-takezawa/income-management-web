// Prisma schema — 年収・給与・有給管理アプリ
// Vercel Postgres + Prisma の公式パターンに準拠
//
// migrations ディレクトリを持たず、デプロイのたびに `prisma db push` でこの
// スキーマをそのまま反映する運用（package.json の vercel-build 参照）。新しい
// @@unique 制約の追加など「データ損失の可能性あり」と判定される変更は db push が
// 対話的確認なしでは失敗するため、--accept-data-loss を付けている。既存データと
// 衝突する制約を追加する変更は、事前に重複行がないか確認してからマージすること。
generator client {
  provider = "prisma-client-js"
}

// Prisma ORM 7 removed `url` / `directUrl` from the datasource block — connection
// strings now live in prisma.config.ts (for the CLI) and are passed to a driver
// adapter at runtime (see src/lib/prisma.ts). We still read the same two Vercel
// Postgres env vars (POSTGRES_PRISMA_URL = pooled, POSTGRES_URL_NON_POOLING = direct)
// to preserve the intent of Vercel's official Prisma+Postgres pattern.
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // "owner" | "member" — plain string (not a Prisma enum) to match this schema's
  // existing convention for small closed value sets (see LeaveUsage.type).
  // The very first user ever created becomes "owner" automatically; ADMIN_EMAIL
  // can also force a specific account to "owner" (see src/actions/auth.ts and
  // the self-healing check in src/auth.ts).
  role         String   @default("member")
  createdAt    DateTime @default(now())

  settings            Settings?
  monthlyRecords      MonthlyRecord[]
  overtimeEntries     OvertimeEntry[]
  bonuses             Bonus[]
  leaveUsages         LeaveUsage[]
  leaveManualGrants   LeaveManualGrant[]
  passwordResetTokens PasswordResetToken[]
  budgetCategories     BudgetCategory[]
  budgetTransactions   BudgetTransaction[]
  recurringBudgetItems RecurringBudgetItem[]
  assetAccounts        AssetAccount[]
}

model Settings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  baseSalary            Int     @default(300000)
  standardMonthlyHours  Int     @default(160)
  overtimeRates         Json    @default("{\"weekday\":25,\"late_night\":50,\"holiday\":35,\"holiday_late_night\":60}")
  hireDate              String?
  annualLeaveDays       Int     @default(10)
  fiscalStartMonth      Int     @default(4)
  age                   Int     @default(30)
  prefecture            String  @default("東京都")
  showNetEstimate       Boolean @default(true)
  allowances            Json    @default("[]")
  onboardingCompleted   Boolean @default(false)
}

// 管理者（role=owner）がユーザーの代わりに発行する、パスワード再設定用の
// 単回使用トークン。生のトークンは保存せず、ハッシュ値のみ保存する。
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MonthlyRecord {
  id                  String  @id @default(cuid())
  userId              String
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  year                Int
  month               Int
  baseSalaryOverride  Int?
  allowancesOverride  Int?
  note                String?

  @@unique([userId, year, month])
  @@index([userId])
}

model OvertimeEntry {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   String
  hours  Json
  note   String?

  @@unique([userId, date])
  @@index([userId])
}

model Bonus {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   String
  name   String
  amount Int

  @@index([userId])
}

model LeaveUsage {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   String
  type   String
  days   Float
  note   String?

  @@unique([userId, date])
  @@index([userId])
}

model LeaveManualGrant {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   String
  days   Float
  note   String?

  @@index([userId])
}

model BudgetCategory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  // "income" | "expense" — LeaveUsage.type と同じ流儀のプレーン文字列
  type      String
  color     String
  // 月間予算の上限（円）。未設定（null）ならアラート対象外。支出カテゴリのみ意味を持つ。
  monthlyLimit Int?
  createdAt DateTime @default(now())

  // 同名カテゴリの重複作成を防ぐ（UI上も紛らわしいため）。副次的に、初回アクセス時の
  // デフォルトカテゴリ作成（getOrCreateBudgetCategories）を createMany + skipDuplicates
  // で冪等にし、同時アクセスによる二重作成を防ぐのにも使う。
  @@unique([userId, name, type])
  @@index([userId])
}

// 毎月決まった額が発生する収支（家賃・サブスク・給与天引きなど）を1回登録すれば、
// 該当日を過ぎた月分の BudgetTransaction を自動生成する。cron 等のバックグラウンド
// ジョブは持たないため、生成は「/budget を開いたときに、前回生成済みの月から今月まで
// 足りない分をまとめて追いつかせる」遅延評価方式（lastGeneratedMonth 参照）。
model RecurringBudgetItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  type       String // "income" | "expense"
  categoryId String
  amount     Int
  // 毎月の発生日（1-28。29日以降は月によって存在しないため許可しない）
  dayOfMonth Int
  memo       String?
  active     Boolean @default(true)
  // 直近で BudgetTransaction を生成し終えた月（YYYY-MM）。null は「まだ一度も生成していない」。
  lastGeneratedMonth String?
  createdAt          DateTime @default(now())

  @@index([userId])
}

model BudgetTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   String
  // "income" | "expense"
  type   String
  // BudgetCategory.id への緩い参照。他モデルと同様に外部キー制約は張らず、
  // カテゴリ削除時の後始末は表示側のフォールバック（「その他」扱い）に任せる。
  categoryId String
  amount     Int
  memo       String?

  // RecurringBudgetItem からの自動生成で使う（手動登録は両方 null）。この2つの一意制約で
  // 同時アクセスによる同一月分の二重生成を防ぐ（skipDuplicates と組み合わせる）。
  // Postgres の一意制約は NULL 同士を重複とみなさないため、手動登録同士は影響を受けない。
  sourceRecurringItemId String?
  sourceMonth           String?

  @@unique([sourceRecurringItemId, sourceMonth])
  @@index([userId])
  @@index([userId, date])
}

model AssetAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  // "cash" | "bank" | "investment"
  type      String
  createdAt DateTime @default(now())

  snapshots AssetSnapshot[]

  @@index([userId])
}

model AssetSnapshot {
  id             String       @id @default(cuid())
  assetAccountId String
  assetAccount   AssetAccount @relation(fields: [assetAccountId], references: [id], onDelete: Cascade)

  date  String
  value Int
  note  String?

  @@index([assetAccountId])
}

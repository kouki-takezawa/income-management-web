# Postgres connection strings. Set these in the Vercel dashboard under Project
# Settings > Environment Variables — they are usually created automatically
# when you attach a Postgres database to the project. The exact env var names
# depend on which integration provisioned the database, so src/lib/env.ts
# resolves them with a fallback chain instead of requiring one fixed name:
#
#   Pooled (runtime, used by src/lib/prisma.ts via @prisma/adapter-pg):
#     DATABASE_URL -> POSTGRES_URL -> POSTGRES_PRISMA_URL
#     -> PRISMA_DATABASE_URL (only if it's a plain postgres:// URL, not a
#        `prisma+postgres://` Accelerate proxy URL)
#
#   Direct/non-pooled (build-time `prisma db push`, used by prisma.config.ts):
#     POSTGRES_URL_NON_POOLING -> POSTGRES_URL -> DATABASE_URL
#
# You only need to set the var names your integration actually provides; you
# do not need every name below. This example lists the classic "Vercel
# Postgres" (Neon) names.
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js / NextAuth.js session encryption secret.
# Generate one locally with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
